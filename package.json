{
  "name": "mets-home-run-apple",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone ESP32 firmware, engineering simulator and virtual Home Run Apple",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:lab": "pnpm run wasm:build && pnpm --filter @apple/apple-lab dev",
    "dev:virtual": "pnpm --filter @apple/virtual-apple dev",
    "native:configure": "cmake -S firmware -B .cache/native -DCMAKE_BUILD_TYPE=Debug",
    "native:build": "pnpm run native:configure && cmake --build .cache/native --parallel",
    "test:native": "pnpm run native:build && ctest --test-dir .cache/native --output-on-failure",
    "native:asan": "cmake -S firmware -B .cache/native-asan -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS=\"-fsanitize=address,undefined -fno-omit-frame-pointer -g\" && cmake --build .cache/native-asan --parallel && ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 ctest --test-dir .cache/native-asan --output-on-failure",
    "wasm:build": "pnpm --filter @apple/game-state-wasm --filter @apple/game-core-wasm --filter @apple/device-display-wasm build",
    "build": "pnpm run wasm:build && pnpm --filter @apple/apple-lab --filter @apple/virtual-apple --filter @apple/notification-worker run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:public": "node scripts/check-public-boundary.mjs",
    "check:assets": "node scripts/check-3d-assets.mjs",
    "check:constants": "node scripts/check-core-constants.mjs",
    "test:unit": "pnpm --filter @apple/protocol --filter @apple/test-fixtures --filter @apple/game-state-wasm --filter @apple/game-core-wasm --filter @apple/device-display-wasm --filter @apple/mlb-live-feed --filter @apple/apple-3d --filter @apple/scoreboard-ui --filter @apple/web-debug --filter @apple/apple-lab --filter @apple/virtual-apple --filter @apple/notification-worker run test",
    "test": "pnpm run check:public && pnpm run check:assets && pnpm run check:constants && pnpm run check:fixtures && pnpm run test:native && pnpm run wasm:build && pnpm run test:unit",
    "fixtures:generate": "node scripts/generate-device-fixtures.mjs",
    "check:fixtures": "node scripts/generate-device-fixtures.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
